POSTGRES_USER=newsscan
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=newsscan

# Optional overrides (defaults shown). All app settings use the NEWSSCAN_ prefix.
# NEWSSCAN_MAX_UPLOAD_MB=10
# NEWSSCAN_MAX_PAGES=10
# NEWSSCAN_OCR_LANG=eng
# NEWSSCAN_OCR_TIMEOUT_SECONDS=60
# NEWSSCAN_LOG_LEVEL=INFO

# Claim checking (ADR-005). Leave empty to switch it off. Never commit real values.
# The recognised text of a scan is sent to Groq when these are set.
# NEWSSCAN_GROQ_API_KEY=
# NEWSSCAN_GROQ_MODEL=
# NEWSSCAN_FACT_CHECK_API_KEY=
# NEWSSCAN_MAX_CLAIMS_PER_SCAN=5

# Upload rate limit per visitor (0 switches a limit off)
# NEWSSCAN_RATE_LIMIT_PER_MINUTE=10
# NEWSSCAN_RATE_LIMIT_PER_DAY=100
